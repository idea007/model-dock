{
  "name": "lab-model-dock",
  "version": "0.1.0",
  "description": "A local-first model gateway with a separate client application demo.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idea007/model-dock.git"
  },
  "homepage": "https://github.com/idea007/model-dock#readme",
  "bugs": {
    "url": "https://github.com/idea007/model-dock/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "model-dock": "apps/gateway/cli.mjs",
    "model-dock-demo": "apps/demo/cli.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "files": [
    "apps/",
    "packages/",
    "examples/",
    "docs/",
    "Start Model Dock.command",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node apps/gateway/cli.mjs serve",
    "dev": "node apps/gateway/cli.mjs serve",
    "console": "node apps/gateway/cli.mjs open",
    "token": "node apps/gateway/cli.mjs token",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "pack:check": "node scripts/pack-smoke.mjs",
    "demo": "node apps/demo/cli.mjs"
  },
  "devDependencies": {
    "@readme/openapi-schemas": "4.0.0",
    "ajv": "8.20.0",
    "jsdom": "27.4.0",
    "openai": "7.56.0"
  }
}
