# Copy to .env.local for this machine's gateway settings.
# MODEL_DOCK_PORT=4320
# MODEL_DOCK_HOME=/absolute/path/to/private/data
# CODEX_CLI_PATH=/absolute/path/to/codex
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
# Optional MFLUX overrides for Apple Silicon macOS.
# MODEL_DOCK_MFLUX_PORT=8016
# MODEL_DOCK_MFLUX_RUNTIME_DIR=/absolute/path/to/private/mflux
# MODEL_DOCK_MFLUX_PYTHON=python3
# Optional MLX Audio overrides for Apple Silicon macOS.
# MODEL_DOCK_TTS_PORT=7720
# MODEL_DOCK_ASR_PORT=7732
# MODEL_DOCK_TTS_MODEL=mlx-community/Kokoro-82M-8bit
# MODEL_DOCK_MLX_AUDIO_RUNTIME_DIR=/absolute/path/to/private/mlx-audio
# MODEL_DOCK_MLX_AUDIO_PYTHON=python3.12
# MODEL_DOCK_TTS_MOSS_WORKERS=2
# MODEL_DOCK_TTS_MOSS_QUEUE=4
# MODEL_DOCK_TTS_MOSS_IDLE_SECONDS=60
# Optional Edge TTS overrides for macOS.
# MODEL_DOCK_EDGE_PORT=8018
# MODEL_DOCK_EDGE_RUNTIME_DIR=/absolute/path/to/private/edge
# MODEL_DOCK_EDGE_PYTHON=python3.12
# MODEL_DOCK_EDGE_PROXY=http://127.0.0.1:7890
# Optional LTX overrides for Apple Silicon macOS.
# MODEL_DOCK_LTX_PORT=7930
# MODEL_DOCK_LTX_RUNTIME_DIR=/absolute/path/to/private/ltx
# Optional Greyscope overrides for Apple Silicon macOS.
# MODEL_DOCK_GREYSCOPE_PORT=7746
# MODEL_DOCK_GREYSCOPE_RUNTIME_DIR=/absolute/path/to/private/greyscope
# Optional managed Ollama overrides for macOS.
# MODEL_DOCK_OLLAMA_PORT=7734
# MODEL_DOCK_OLLAMA_RUNTIME_DIR=/absolute/path/to/private/ollama
# Save provider keys and service access tokens in Connections & credentials.
