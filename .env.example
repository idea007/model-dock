# Environment variables are read from the process; .env is not loaded automatically.
MODEL_DOCK_PORT=4317
# MODEL_DOCK_HOME=/absolute/path/to/private/data
# MODEL_DOCK_DEMO_HOME=/absolute/path/to/private/client-data
# CODEX_CLI_PATH=/absolute/path/to/codex
# Codex respects explicit proxy variables. On macOS, an already enabled loopback
# system proxy is detected when no proxy variable is set. This file is only an example.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
